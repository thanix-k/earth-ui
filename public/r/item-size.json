{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "item-size",
  "title": "Item Size",
  "description": "Item example: Sizes.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@earth-ui/item"
  ],
  "files": [
    {
      "path": "registry/default/examples/item-size.tsx",
      "content": "import { InboxIcon } from \"lucide-react\";\n\nimport {\n  Item,\n  ItemContent,\n  ItemDescription,\n  ItemMedia,\n  ItemTitle,\n} from \"@/registry/default/ui/item\";\n\nexport function ItemSizeDemo() {\n  return (\n    <div className=\"flex w-full max-w-md flex-col gap-6\">\n      <Item variant=\"outline\">\n        <ItemMedia variant=\"icon\">\n          <InboxIcon />\n        </ItemMedia>\n        <ItemContent>\n          <ItemTitle>Default Size</ItemTitle>\n          <ItemDescription>The standard size for most use cases.</ItemDescription>\n        </ItemContent>\n      </Item>\n      <Item variant=\"outline\" size=\"sm\">\n        <ItemMedia variant=\"icon\">\n          <InboxIcon />\n        </ItemMedia>\n        <ItemContent>\n          <ItemTitle>Small Size</ItemTitle>\n          <ItemDescription>A compact size for dense layouts.</ItemDescription>\n        </ItemContent>\n      </Item>\n      <Item variant=\"outline\" size=\"xs\">\n        <ItemMedia variant=\"icon\">\n          <InboxIcon />\n        </ItemMedia>\n        <ItemContent>\n          <ItemTitle>Extra Small Size</ItemTitle>\n          <ItemDescription>The most compact size available.</ItemDescription>\n        </ItemContent>\n      </Item>\n    </div>\n  );\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}
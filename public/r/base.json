{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "base",
  "title": "Earth base",
  "description": "Earth (setmore-black) tokens, shadcn aliases, focus ring and the Inter font. Install first.",
  "dependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "lucide-react"
  ],
  "registryDependencies": [
    "@earth-ui/cn",
    "@earth-ui/font-inter",
    "@earth-ui/theme"
  ],
  "cssVars": {
    "light": {
      "background": "#ffffff",
      "foreground": "#111111",
      "card": "#ffffff",
      "card-foreground": "#111111",
      "popover": "#ffffff",
      "popover-foreground": "#111111",
      "primary": "#111111",
      "primary-foreground": "#ffffff",
      "secondary": "#f4f4f4",
      "secondary-foreground": "#111111",
      "muted": "#f4f4f4",
      "muted-foreground": "#676767",
      "accent": "#f1f1f1",
      "accent-foreground": "#111111",
      "destructive": "#c44c44",
      "border": "#dbdbdb",
      "input": "#dbdbdb",
      "ring": "#111111",
      "chart-1": "#111111",
      "chart-2": "#666666",
      "chart-3": "#999999",
      "chart-4": "#b2b2b2",
      "chart-5": "#c7c7c7",
      "sidebar": "#fafafa",
      "sidebar-foreground": "#111111",
      "sidebar-primary": "#111111",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "#f1f1f1",
      "sidebar-accent-foreground": "#111111",
      "sidebar-border": "#dbdbdb",
      "sidebar-ring": "#111111"
    },
    "dark": {
      "background": "#1a1a1a",
      "foreground": "#eeeeee",
      "card": "#1a1a1a",
      "card-foreground": "#eeeeee",
      "popover": "#1e1e1e",
      "popover-foreground": "#eeeeee",
      "primary": "#eeeeee",
      "primary-foreground": "#1e1e1e",
      "secondary": "#292929",
      "secondary-foreground": "#eeeeee",
      "muted": "#292929",
      "muted-foreground": "#949494",
      "accent": "#333333",
      "accent-foreground": "#eeeeee",
      "destructive": "#c44c44",
      "border": "#3d3d3d",
      "input": "#3d3d3d",
      "ring": "#eeeeee",
      "chart-1": "#eeeeee",
      "chart-2": "#b2b2b2",
      "chart-3": "#999999",
      "chart-4": "#808080",
      "chart-5": "#666666",
      "sidebar": "#212121",
      "sidebar-foreground": "#eeeeee",
      "sidebar-primary": "#eeeeee",
      "sidebar-primary-foreground": "#1e1e1e",
      "sidebar-accent": "#333333",
      "sidebar-accent-foreground": "#eeeeee",
      "sidebar-border": "#3d3d3d",
      "sidebar-ring": "#eeeeee"
    }
  },
  "css": {
    "@layer base": {
      "*": {
        "@apply border-border outline-ring": {}
      },
      "body": {
        "@apply bg-background text-foreground font-sans": {}
      }
    }
  },
  "type": "registry:base",
  "config": {
    "style": "base-nova",
    "tailwind": {
      "baseColor": "neutral"
    },
    "iconLibrary": "lucide",
    "registries": {
      "@earth-ui": "https://earthui.vercel.app/r/{name}.json"
    }
  }
}
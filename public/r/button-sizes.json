{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button-sizes",
  "title": "Button Sizes",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@earth/button"
  ],
  "files": [
    {
      "path": "registry/default/examples/button-sizes.tsx",
      "content": "import { ArrowUpRightIcon } from \"lucide-react\";\nimport { Button } from \"@/registry/default/ui/button\";\n\nexport default function ButtonSizes() {\n  return (\n    <div className=\"flex flex-col items-center gap-6\">\n      <div className=\"flex flex-wrap items-center gap-2\">\n        <Button size=\"xs\">Extra small</Button>\n        <Button size=\"sm\">Small</Button>\n        <Button>Default</Button>\n        <Button size=\"lg\">Large</Button>\n      </div>\n      <div className=\"flex flex-wrap items-center gap-2\">\n        <Button size=\"icon-xs\" variant=\"outline\" aria-label=\"Open\">\n          <ArrowUpRightIcon />\n        </Button>\n        <Button size=\"icon-sm\" variant=\"outline\" aria-label=\"Open\">\n          <ArrowUpRightIcon />\n        </Button>\n        <Button size=\"icon\" variant=\"outline\" aria-label=\"Open\">\n          <ArrowUpRightIcon />\n        </Button>\n        <Button size=\"icon-lg\" variant=\"outline\" aria-label=\"Open\">\n          <ArrowUpRightIcon />\n        </Button>\n      </div>\n    </div>\n  );\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}
{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "field-demo",
  "title": "Field Demo",
  "dependencies": [],
  "registryDependencies": [
    "@earth/button",
    "@earth/checkbox",
    "@earth/field",
    "@earth/input",
    "@earth/native-select",

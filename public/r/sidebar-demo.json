{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-demo",
  "title": "Sidebar Demo",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@earth/breadcrumb",
    "@earth/separator",
    "@earth/sidebar"
  ],
  "files": [
    {
      "path": "registry/default/examples/sidebar-demo.tsx",
      "content": "\"use client\";\n\nimport {\n  CalendarDaysIcon,\n  ChartColumnIcon,\n  ChevronsUpDownIcon,\n  ClipboardListIcon,\n  ContactIcon,\n  GlobeIcon,\n  MessageSquareIcon,\n  PlusIcon,\n  SettingsIcon,\n  StarIcon,\n  UsersIcon,\n} from \"lucide-react\";\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from \"@/registry/default/ui/breadcrumb\";\nimport { Separator } from \"@/registry/default/ui/separator\";\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupAction,\n  SidebarGroupContent,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuBadge,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarProvider,\n  SidebarRail,\n  SidebarTrigger,\n} from \"@/registry/default/ui/sidebar\";\n\nconst schedule = [\n  { title: \"Calendar\", url: \"/calendar\", icon: CalendarDaysIcon, isActive: true },\n  { title: \"Appointments\", url: \"/appointments\", icon: ClipboardListIcon, badge: 12 },\n  { title: \"Customers\", url: \"/customers\", icon: ContactIcon },\n  { title: \"Messages\", url: \"/messages\", icon: MessageSquareIcon, badge: 3 },\n];\n\nconst business = [\n  { title: \"Booking page\", url: \"/booking-page\", icon: GlobeIcon },\n  { title: \"Staff\", url: \"/staff\", icon: UsersIcon },\n  { title: \"Reviews\", url: \"/reviews\", icon: StarIcon },\n  { title: \"Reports\", url: \"/reports\", icon: ChartColumnIcon },\n];\n\nexport default function SidebarDemo() {\n  return (\n    <SidebarProvider>\n      <Sidebar collapsible=\"icon\">\n        <SidebarHeader>\n          <SidebarMenu>\n            <SidebarMenuItem>\n              <SidebarMenuButton size=\"lg\" tooltip=\"Glow Salon\">\n                <span className=\"flex size-8 shrink-0 items-center justify-center rounded-lg bg-eds-accent text-body-14 font-semibold text-eds-onPrimary\">\n                  G\n                </span>\n                <span className=\"flex min-w-0 flex-1 flex-col\">\n                  <span className=\"truncate font-medium\">Glow Salon</span>\n                  <span className=\"truncate text-body-12 text-eds-secondary lg:text-body-10\">\n                    Premium plan\n                  </span>\n                </span>\n                <ChevronsUpDownIcon className=\"ms-auto\" />\n              </SidebarMenuButton>\n            </SidebarMenuItem>\n          </SidebarMenu>\n        </SidebarHeader>\n        <SidebarContent>\n          <SidebarGroup>\n            <SidebarGroupLabel>Schedule</SidebarGroupLabel>\n            <SidebarGroupAction title=\"New appointment\">\n              <PlusIcon />\n              <span className=\"sr-only\">New appointment</span>\n            </SidebarGroupAction>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                {schedule.map((item) => (\n                  <SidebarMenuItem key={item.title}>\n                    <SidebarMenuButton\n                      isActive={item.isActive}\n                      tooltip={item.title}\n                      render={<a href={item.url} />}\n                    >\n                      <item.icon />\n                      <span>{item.title}</span>\n                    </SidebarMenuButton>\n                    {item.badge ? <SidebarMenuBadge>{item.badge}</SidebarMenuBadge> : null}\n                  </SidebarMenuItem>\n                ))}\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n          <SidebarGroup>\n            <SidebarGroupLabel>Business</SidebarGroupLabel>\n            <SidebarGroupContent>\n              <SidebarMenu>\n                {business.map((item) => (\n                  <SidebarMenuItem key={item.title}>\n                    <SidebarMenuButton tooltip={item.title} render={<a href={item.url} />}>\n                      <item.icon />\n                      <span>{item.title}</span>\n                    </SidebarMenuButton>\n                  </SidebarMenuItem>\n                ))}\n              </SidebarMenu>\n            </SidebarGroupContent>\n          </SidebarGroup>\n        </SidebarContent>\n        <SidebarFooter>\n          <SidebarMenu>\n            <SidebarMenuItem>\n              <SidebarMenuButton tooltip=\"Settings\" render={<a href=\"/settings\" />}>\n                <SettingsIcon />\n                <span>Settings</span>\n              </SidebarMenuButton>\n            </SidebarMenuItem>\n            <SidebarMenuItem>\n              <SidebarMenuButton size=\"lg\" tooltip=\"Maya Patel\">\n                <span className=\"flex size-8 shrink-0 items-center justify-center rounded-full bg-eds-avatar text-body-12 font-medium text-eds-primary\">\n                  MP\n                </span>\n                <span className=\"flex min-w-0 flex-1 flex-col\">\n                  <span className=\"truncate font-medium\">Maya Patel</span>\n                  <span className=\"truncate text-body-12 text-eds-secondary lg:text-body-10\">\n                    maya@glowsalon.com\n                  </span>\n                </span>\n              </SidebarMenuButton>\n            </SidebarMenuItem>\n          </SidebarMenu>\n        </SidebarFooter>\n        <SidebarRail />\n      </Sidebar>\n      <SidebarInset>\n        <header className=\"flex h-14 shrink-0 items-center gap-2 border-b border-eds-tertiary px-4\">\n          <SidebarTrigger className=\"-ms-1\" />\n          <Separator orientation=\"vertical\" className=\"me-2 h-4 self-center\" />\n          <Breadcrumb>\n            <BreadcrumbList>\n              <BreadcrumbItem className=\"hidden md:inline-flex\">\n                <BreadcrumbLink href=\"#\">Schedule</BreadcrumbLink>\n              </BreadcrumbItem>\n              <BreadcrumbSeparator className=\"hidden md:block\" />\n              <BreadcrumbItem>\n                <BreadcrumbPage>Calendar</BreadcrumbPage>\n              </BreadcrumbItem>\n            </BreadcrumbList>\n          </Breadcrumb>\n        </header>\n        <div className=\"flex flex-1 flex-col gap-4 p-4\">\n          <div className=\"grid gap-4 md:grid-cols-3\">\n            <div className=\"h-28 rounded-xl bg-eds-canvas-tertiary\" />\n            <div className=\"h-28 rounded-xl bg-eds-canvas-tertiary\" />\n            <div className=\"h-28 rounded-xl bg-eds-canvas-tertiary\" />\n          </div>\n          <div className=\"min-h-96 flex-1 rounded-xl bg-eds-canvas-tertiary\" />\n        </div>\n      </SidebarInset>\n    </SidebarProvider>\n  );\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}
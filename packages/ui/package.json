{
  "name": "eds-ui",
  "version": "0.1.0",
  "description": "shadcn/ui components with the Earth UI preset.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thanix-k/earth-ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src/index.css",
    "tailwind.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tailwind.css": "./tailwind.css",
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./examples/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build",
    "registry:build": "shadcn build -o ../../apps/docs/public/r"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^10.0.2",
    "react-resizable-panels": "^4.21.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vite-plugin-dts": "^5"
  }
}
